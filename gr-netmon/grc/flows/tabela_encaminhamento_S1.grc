options:
  parameters:
    author: jon
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Consulta periódica da tabela de encaminhamento do switch s1'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: tabela_encaminhamento_S1
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Tabela de Encaminhamento S1 (AUTO)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 40]
    rotation: 0
    state: enabled
- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.intern("tick")
    period: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 200]
    rotation: 0
    state: true
- name: netmon_forwarding_table_s1_0
  id: netmon_forwarding_table_s1
  parameters:
    container_name: s1
    update_interval: '1.0'
    colorize: 'False'
    log_to_file: 'False'
    log_dir: ./raw
    auto_start: 'True'
    bridge_override: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 200]
    rotation: 0
    state: true
- name: qtgui_edit_box_msg_0
  id: qtgui_edit_box_msg
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gui_hint: ''
    is_pair: 'False'
    is_static: 'False'
    key: ''
    label: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: string
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [620, 200]
    rotation: 0
    state: true
- name: message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gui_hint: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: message
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [540, 260]
    rotation: 0
    state: true
- name: null_src_0
  id: blocks_null_source
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 360]
    rotation: 0
    state: enabled
- name: throttle_0
  id: blocks_throttle
  parameters:
    alias: ''
    comment: ''
    sample_rate: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 360]
    rotation: 0
    state: enabled
- name: null_sink_0
  id: blocks_null_sink
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 360]
    rotation: 0
    state: enabled

connections:
- [null_src_0, '0', throttle_0, '0']
- [throttle_0, '0', null_sink_0, '0']
- [blocks_message_strobe_0, strobe, netmon_forwarding_table_s1_0, tick]
- [netmon_forwarding_table_s1_0, out, qtgui_edit_box_msg_0, val]
- [netmon_forwarding_table_s1_0, metrics, message_debug_0, print]

metadata:
  file_format: 1
