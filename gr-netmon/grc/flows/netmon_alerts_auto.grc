options:
  parameters:
    author: netmon
    catch_exceptions: 'True'
    category: '[Network]/Monitoring'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Alerts from host ping raw files'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: netmon_alerts_auto
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Alerts (auto)
    window_size: (800,600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: netmon_alerts_0
  id: netmon_alerts
  parameters:
    files: ./raw/host_ping_auto.txt
    interval: '2.0'
    latency_threshold_ms: '50.0'
    loss_threshold_pct: '10.0'
    jitter_threshold_ms: '20.0'
    log_to_file: 'True'
    log_dir: ./raw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 140]
    rotation: 0
    state: true
- name: null_src_0
  id: blocks_null_source
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 320]
    rotation: 0
    state: enabled
- name: throttle_0
  id: blocks_throttle
  parameters:
    alias: ''
    comment: ''
    sample_rate: '100'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 320]
    rotation: 0
    state: enabled
- name: null_sink_0
  id: blocks_null_sink
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 320]
    rotation: 0
    state: enabled

connections:
- [null_src_0, '0', throttle_0, '0']
- [throttle_0, '0', null_sink_0, '0']

metadata:
  file_format: 1