options:
  parameters:
    author: netmon
    catch_exceptions: 'True'
    category: '[Network]/Monitoring'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Tcpdump PCAP exporter with rotation'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: netmon_pcap_exporter_auto
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: PCAP Exporter (auto)
    window_size: (800,600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: netmon_pcap_exporter_0
  id: netmon_pcap_exporter
  parameters:
    container_name: h1
    interface: eth0
    filter: ip
    pcap_dir: /tmp
    file_prefix: capture
    duration: '10'
    interval: '10.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 140]
    rotation: 0
    state: true
- name: null_src_0
  id: blocks_null_source
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 320]
    rotation: 0
    state: enabled
- name: throttle_0
  id: blocks_throttle
  parameters:
    alias: ''
    comment: ''
    sample_rate: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 320]
    rotation: 0
    state: enabled
- name: null_sink_0
  id: blocks_null_sink
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 320]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 80]
    rotation: 0
    state: enabled

connections:
- [null_src_0, '0', throttle_0, '0']
- [throttle_0, '0', null_sink_0, '0']

metadata:
  file_format: 1