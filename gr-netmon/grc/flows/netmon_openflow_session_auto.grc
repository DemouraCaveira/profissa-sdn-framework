options:
  parameters:
    author: netmon
    catch_exceptions: 'True'
    category: '[Network]/Monitoring'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Monitor OpenFlow session on switch container'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: netmon_openflow_session_auto
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: OpenFlow Session (auto)
    window_size: (800,600)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: netmon_openflow_session_0
  id: netmon_openflow_session
  parameters:
    container_name: s1
    interval: '5.0'
    log_to_file: 'True'
    log_dir: ./raw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 140]
    rotation: 0
    state: true
- name: null_src_0
  id: blocks_null_source
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 320]
    rotation: 0
    state: enabled
- name: message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gui_hint: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    type: message
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 140]
    rotation: 0
    state: true
- name: throttle_0
  id: blocks_throttle
  parameters:
    alias: ''
    comment: ''
    sample_rate: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 320]
    rotation: 0
    state: enabled
- name: null_sink_0
  id: blocks_null_sink
  parameters:
    type: float
    vlen: '1'
    alias: ''
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 320]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [40, 80]
    rotation: 0
    state: enabled

connections:
- [null_src_0, '0', throttle_0, '0']
- [throttle_0, '0', null_sink_0, '0']
- [netmon_openflow_session_0, metrics, message_debug_0, print]

metadata:
  file_format: 1